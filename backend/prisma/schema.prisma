// Prisma Schema for IMEI Verification Platform
// Configured with SQLite for ultralight local development (0 MB Docker overhead)
// Easily switchable to PostgreSQL by changing provider to "postgresql" and DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  name         String?
  role         String   @default("USER") // USER, ADMIN, OWNER, PARTNER
  status       String   @default("ACTIVE") // ACTIVE, BLOCKED
  passwordHash String?
  partnerId    String?  // linked if role is PARTNER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions           UserSession[]
  payments           Payment[]
  creditTransactions CreditTransaction[]
  verifications      VerificationRequest[]
  auditLogs          AuditLog[]

  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model Package {
  id          String   @id @default(uuid())
  name        String
  credits     Int
  price       Float
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  sortOrder   Int      @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]

  @@map("packages")
}

model Payment {
  id                    String   @id @default(uuid())
  userId                String
  packageId             String
  amount                Float
  provider              String   @default("PAYME") // PAYME, CLICK, UZUM, MOCK
  providerTransactionId String?  @unique
  status                String   @default("PENDING") // PENDING, PAID, FAILED, CANCELLED, REFUNDED
  idempotencyKey        String   @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  package Package @relation(fields: [packageId], references: [id])

  @@index([userId])
  @@map("payments")
}

model CreditTransaction {
  id             String   @id @default(uuid())
  userId         String
  type           String   // PACKAGE_PURCHASE, VERIFICATION_DEDUCTION, ADMIN_ADJUSTMENT, REFUND
  credits        Int      // Positive for credit addition, negative for deduction
  balanceAfter   Int
  referenceType  String   // PAYMENT, VERIFICATION, ADMIN
  referenceId    String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("credit_transactions")
}

model VerificationRequest {
  id                String    @id @default(uuid())
  userId            String
  requestId         String    @unique
  imeiHash          String
  maskedImei        String
  status            String    @default("PROCESSING") // PROCESSING, CLEAR, ACTIVE_INSTALLMENT, INVALID_IMEI, PROVIDER_UNAVAILABLE
  matchedPartnerId  String?
  matchedPartnerName String?
  chargedCreditTxId String?
  latencyMs         Int?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  user    User                 @relation(fields: [userId], references: [id])
  results VerificationResult[]

  @@index([userId])
  @@index([imeiHash])
  @@map("verification_requests")
}

model VerificationResult {
  id                    String   @id @default(uuid())
  verificationRequestId String
  partnerId             String
  partnerName           String
  sourceType            String   // API, CABINET, CSV
  found                 Boolean
  status                String?  // ACTIVE, PAID, BLOCKED
  latencyMs             Int      @default(0)
  rawResponse           String?  // JSON string
  rawError              String?
  createdAt             DateTime @default(now())

  verificationRequest VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@index([verificationRequestId])
  @@map("verification_results")
}

model Partner {
  id              String   @id @default(uuid())
  name            String
  integrationType String   @default("CABINET") // API, CABINET, CSV
  status          String   @default("ACTIVE")  // ACTIVE, INACTIVE, TEST
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  apiConfig     PartnerApiConfig?
  devices       PartnerDevice[]
  importBatches PartnerImportBatch[]

  @@map("partners")
}

model PartnerApiConfig {
  id                   String   @id @default(uuid())
  partnerId            String   @unique
  endpointRef          String
  encryptedCredentials String?
  timeoutMs            Int      @default(3000)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_api_configs")
}

model PartnerDevice {
  id            String   @id @default(uuid())
  partnerId     String
  imeiHash      String
  maskedImei    String
  status        String   @default("ACTIVE") // ACTIVE, PAID, BLOCKED
  sourceType    String   @default("CABINET") // CABINET, CSV
  importBatchId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  partner     Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  importBatch PartnerImportBatch? @relation(fields: [importBatchId], references: [id])

  @@unique([partnerId, imeiHash])
  @@index([imeiHash])
  @@index([partnerId])
  @@map("partner_devices")
}

model PartnerImportBatch {
  id           String   @id @default(uuid())
  partnerId    String
  fileName     String
  rowCount     Int
  successCount Int
  failCount    Int
  reportJson   String?  // Detailed errors or skipped rows JSON
  createdAt    DateTime @default(now())

  partner Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  devices PartnerDevice[]

  @@index([partnerId])
  @@map("partner_import_batches")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorType  String   // USER, ADMIN, OWNER, PARTNER, SYSTEM
  actorId    String?
  action     String   // ADMIN_LOGIN, USER_STATUS_CHANGED, etc.
  targetType String?
  targetId   String?
  oldValue   String?
  newValue   String?
  ip         String?
  requestId  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model SystemLog {
  id        String   @id @default(uuid())
  service   String
  level     String   @default("INFO") // INFO, WARN, ERROR
  message   String
  metadata  String?  // JSON string
  requestId String?
  createdAt DateTime @default(now())

  @@index([service])
  @@index([level])
  @@map("system_logs")
}
